<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Duende.IdentityServer">
      <Version>8.0.11</Version>
    </PackageReference>

    <!--
      Bump a transitive dependency: Microsoft.Extensions.Caching.Hybrid pulls
      Microsoft.Extensions.DependencyModel 2.0.4, which pulls Newtonsoft.Json 9.0.1
      (known high-severity CVE). Force a patched version.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- Windows service support so the IdP can run natively (UseWindowsService). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />

    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

</Project>
