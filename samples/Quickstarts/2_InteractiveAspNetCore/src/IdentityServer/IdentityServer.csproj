<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="IdentityServer4" Version="4.1.2" />

    <!--
      Direct references (not transitive pins): IdentityServer4 4.1.2 pulls
      5.6.0 of both, which is vulnerable (GHSA-59j7-ghrg-fj52,
      GHSA-8g9c-28fc-mcx2). Scoped here so the Api's JwtBearer 11 stack
      (8.19.2) is not downgraded.
    -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="5.7.2" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="5.7.2" />

    <PackageReference Include="Serilog.AspNetCore" Version="3.4.0" />

    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="3.1.5" />

    <!-- Windows service support so the IdP can run natively (UseWindowsService). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0" />
  </ItemGroup>
    
</Project>
