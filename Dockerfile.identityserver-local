FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

# Copy the Central Package Management file so versionless PackageReferences
# (e.g. Serilog.AspNetCore) resolve during restore, then copy the project.
COPY samples/Quickstarts/Directory.Build.targets ./
COPY samples/Quickstarts/2_InteractiveAspNetCore/src/IdentityServer/*.csproj ./
RUN dotnet restore

# Copy all source files
COPY samples/Quickstarts/2_InteractiveAspNetCore/src/IdentityServer/ ./

# Build the project
RUN dotnet publish -c Release -o /app/publish

# Runtime stage — the app targets net10.0, so it must run on the .NET 10 runtime
FROM mcr.microsoft.com/dotnet/aspnet:10.0

WORKDIR /app

# Copy published output (includes wwwroot, Views, etc)
COPY --from=build /app/publish .

# Expose port
EXPOSE 5555

# Set environment
ENV ASPNETCORE_URLS=http://+:5555
ENV ASPNETCORE_ENVIRONMENT=Development

# Run the application
ENTRYPOINT ["dotnet", "IdentityServer.dll"]
